        </mxCell>

        
        <mxCell id="inline_fit" value="放置Block&amp;#xa;position(left=cursor_x, top=cursor_y)&amp;#xa;cursor_x += block.width" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
