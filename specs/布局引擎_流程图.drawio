        <mxCell id="check_page_full_inline" value="cursor_y + text_line_height&amp;#xa;&gt; TEXT_BOX_HEIGHT?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
