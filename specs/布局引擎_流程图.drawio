        </mxCell>

        
        <mxCell id="check_width" value="剩余水平宽度≥block.width?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
