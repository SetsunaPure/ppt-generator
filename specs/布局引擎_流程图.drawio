        <mxCell id="inline_nofit" value="换行：cursor_y += text_line_height&amp;#xa;cursor_x = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
